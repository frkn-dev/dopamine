<?xml version="1.0" encoding="UTF-8"?>
<CPackWiXPatch>
    <CPackWiXFragment Id="CM_CP_dopamine_service.exe">
        <ServiceInstall
                Id="DopamineServiceInstall"
                Name="dopamine-service"
                DisplayName="Dopamine Service"
                Description="Service for Dopamine"
                Start="auto"
                Type="ownProcess"
                ErrorControl="normal"
                Vital="yes">
            <ServiceDependency Id="BFE" />
            <ServiceDependency Id="nsi" />
        </ServiceInstall>
        <!-- auto-restart on crash: without this a single service crash left the
             client permanently dead ("Background service is not running") until
             a manual reboot/reinstall -->
        <util:ServiceConfig
                ServiceName="dopamine-service"
                FirstFailureActionType="restart"
                SecondFailureActionType="restart"
                ThirdFailureActionType="restart"
                RestartServiceDelayInSeconds="5"
                ResetPeriodInDays="1" />
        <ServiceControl
                Id="DopamineServiceControl"
                Name="dopamine-service"
                Start="install"
                Stop="both"
                Remove="uninstall"
                Wait="yes" />
        <!-- legacy rebrand cleanup: stop and remove the old FRKN-service if present -->
        <ServiceControl
                Id="LegacyFrknServiceControl"
                Name="FRKN-service"
                Stop="install"
                Remove="install"
                Wait="yes" />
    </CPackWiXFragment>
</CPackWiXPatch>